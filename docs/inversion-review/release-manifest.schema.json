{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ncimeta:release-manifest:1",
  "title": "Source release manifest",
  "description": "Editable release configuration independent of the historical replay catalog. References name typed artifacts; preflight fingerprints them. Schema acceptance does not authorize execution or production use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "profile",
    "purpose",
    "configuration",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "ncimeta-release-manifest"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "purpose": {
      "enum": [
        "historical-replay",
        "shadow"
      ]
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/reference"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "uri",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "archive_member": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "archive_format": {
          "enum": [
            "tar.gz",
            "zip"
          ]
        }
      },
      "dependentRequired": {
        "archive_member": [
          "archive_sha256",
          "archive_bytes",
          "archive_format"
        ],
        "archive_sha256": [
          "archive_member",
          "archive_bytes",
          "archive_format"
        ],
        "archive_bytes": [
          "archive_member",
          "archive_sha256",
          "archive_format"
        ],
        "archive_format": [
          "archive_member",
          "archive_sha256",
          "archive_bytes"
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "source",
        "version",
        "provenance",
        "files",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_type": {
          "enum": [
            "publisher-bundle",
            "prepared-bundle",
            "ncimeta-state",
            "identity-state",
            "source-plan",
            "policy",
            "id-allocation",
            "reference-inversion",
            "publisher-history",
            "environment-profile",
            "validation-profile"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer",
            "producer_version",
            "capture_id",
            "evidence_kind"
          ],
          "properties": {
            "producer": {
              "type": "string",
              "minLength": 1
            },
            "producer_version": {
              "type": "string",
              "minLength": 1
            },
            "capture_id": {
              "type": "string",
              "minLength": 1
            },
            "evidence_kind": {
              "enum": [
                "preserved",
                "captured",
                "synthetic-fixture"
              ]
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "data": {
          "type": "object"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "version",
        "engine_ref",
        "policy_ref",
        "environment_profile",
        "replacement_baseline",
        "comparison_baseline",
        "publisher_history",
        "inputs",
        "source_atom_ids",
        "validation_profile",
        "output_stage",
        "source_options"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "engine_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "$ref": "#/$defs/reference"
        },
        "environment_profile": {
          "$ref": "#/$defs/reference"
        },
        "replacement_baseline": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "version"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_baseline": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "version"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher_history": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_data",
            "source_data_stage",
            "reference_ncimeta",
            "identity_state",
            "source_plan"
          ],
          "properties": {
            "source_data": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/reference"
              }
            },
            "source_data_stage": {
              "enum": [
                "publisher",
                "prepared"
              ]
            },
            "reference_ncimeta": {
              "oneOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "identity_state": {
              "oneOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_plan": {
              "oneOf": [
                {
                  "$ref": "#/$defs/reference"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "source_atom_ids": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "bound_kind",
                "provenance_ref"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "bound_kind": {
                  "enum": [
                    "reserved-historical-range",
                    "historical-emitted-range",
                    "dev-reservation",
                    "production-reservation"
                  ]
                },
                "provenance_ref": {
                  "$ref": "#/$defs/reference"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_profile": {
          "$ref": "#/$defs/reference"
        },
        "output_stage": {
          "enum": [
            "inversion-src",
            "insertion-package"
          ]
        },
        "source_options": {
          "type": "object"
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_ref",
            "reference_stage",
            "comparison_profile"
          ],
          "properties": {
            "reference_ref": {
              "$ref": "#/$defs/reference"
            },
            "reference_stage": {
              "enum": [
                "inversion-src",
                "insertion-package"
              ]
            },
            "comparison_profile": {
              "enum": [
                "exact",
                "semantic-strict",
                "reviewed-corrections"
              ]
            }
          }
        }
      }
    }
  }
}
